# MPC Skipback settings. Read when MPC starts.

# 0 leaves the library loaded but idle.
enabled=1

# Seconds of main out saved by each trigger, 1..60. The rolling buffer is the same size whatever this is: it
# grows to about 48 MB of RAM over the first couple of minutes and stays there.
window_sec=30

# Where the WAVs go, in a Skipback folder. "auto" takes the first that is there at save time:
#   1. a mounted USB drive or SSD (writable),  2. a mounted external SD card (writable),
#   3. this device's own Samples folder (as MPC's settings name it, else <Force|MPC|APC> Documents/Samples, else /data/Skipback).
# A drive that has its own "<Force|MPC|APC> Documents/Samples" folder is used there, otherwise at its top level.
# "samples" is 3 only. Or an absolute path, used as it is (the folder is created).
output_dir=auto

# A save starts when this file appears; the addin deletes it. Touch it from anything: a button
# remap, a script, a plugin.
trigger=/tmp/mpc-addin-skipback.trigger

# Written after every save: "ok <path of the WAV>" or "error <reason>". Wait for it to change
# (or appear) to know the save finished.
done=/tmp/mpc-addin-skipback.done

# 1 mixes a short click into main out when a save has finished. It is not recorded.
click=0

# The channels of MPC's playback stream that carry main out (0-based), and the codec's ALSA card
# (auto: the one /dev/snd/by-path/platform-sound points at).
left=0
right=1
tap_card=auto

# The controller button whose double press saves (a channel-1 note):
#   auto   93 (Rec Arm) on a Force, 80 (Overdub) on other models. The default.
#   learn  the first button you double-press becomes the button; it is remembered in button.learned (delete that file
#          to learn again). A click (and, on a Force, the LED) confirms it. Use it where the buttons are not known yet.
#   <n>    a note number: 93 Rec Arm and 73 Rec on a Force; 80 Overdub, 73 Rec, 83 Play Start on the MPC family.
#   0      no button; use the trigger file.
# The first press still reaches MPC, so it does what it always does; use a button where a quick double press is harmless.
button=auto
# Two presses within this many ms are a double press.
double_ms=350

# LED feedback on the button above (or led_button, a button number): led_fast_blinks quick blinks as soon as the
# press registers, then led_blinks slow ones when the WAV is written. After each run the value MPC had given the
# LED is put back. led_on is the lit half's LED value, led_ms / led_fast_ms the length of each half in ms.
# MPC sets button LEDs with control changes on channel 1 (controller = button, value = state). That is only known to
# work on a Force, so led=auto (the default) uses it there and sends nothing to other models; led=1 forces it on,
# led=0 turns it off.
led=auto
led_button=auto
led_on=3
led_blinks=3
led_ms=250
led_fast_blinks=3
led_fast_ms=50

# 1 logs controller presses and every LED change MPC makes, to find the values for led_on. Leave it 0 otherwise.
midi_log=0

# How often the trigger file is looked for, ms.
poll_ms=100

# "auto": skipback.log in this folder. An absolute path, or empty for no log.
log=auto
